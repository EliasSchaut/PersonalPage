# --- Contact form (SMTP) --------------------------------------------------
# Local dev: `pnpm dev:services` starts MailDev, then use
#   SMTP_HOST=127.0.0.1  SMTP_PORT=1025  SMTP_SECURE=false  (inbox: http://localhost:1080)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true
SMTP_FROM="Elias Schaut <hi@schaut.dev>"
SMTP_TO=hi@schaut.dev

# --- Sveltia CMS (GitHub OAuth App, callback: https://schaut.dev/api/oauth/callback)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Comma separated origins allowed to receive the OAuth token (the CMS host)
CMS_ALLOWED_ORIGINS=https://schaut.dev

# --- Newsletter (Listmonk, docker-compose.listmonk.yml) --------------------
LISTMONK_URL=https://lists.schaut.dev
LISTMONK_LIST_EN=
LISTMONK_LIST_DE=

# --- Runtime (docker-compose) ---------------------------------------------
PORT=3000
ORIGIN=https://schaut.dev
