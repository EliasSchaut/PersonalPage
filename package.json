{
  "name": "personal-page",
  "packageManager": "pnpm@12.6.0",
  "description": "My personal website about me and my projects",
  "author": "EliasSchaut",
  "private": true,
  "license": "MIT",
  "type": "module",
  "homepage": "https://schaut.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/EliasSchaut/PersonalPage.git"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:services": "docker compose -f docker-compose.dev.yml up -d",
    "dev:services:down": "docker compose -f docker-compose.dev.yml down",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest --run",
    "test:e2e": "playwright test",
    "migrate:content": "node scripts/migrate-content.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.97",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.13.6",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "fuse.js": "^7.5.0",
    "globals": "^17.12.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-string": "^3.0.1",
    "nodemailer": "^10.0.10",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "typewriter-effect": "^2.22.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
