# Loaded automatically by `pnpm dev` (Vite mode "development"), overrides `.env`.
# Contains no secrets; pair it with `docker compose -f docker-compose.dev.yml up -d`.

# --- Contact form -> MailDev (inbox at http://localhost:1080) --------------
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM="Personal Page Dev <dev@localhost>"
SMTP_TO=hi@localhost

# --- Sveltia CMS (leave empty; /admin needs a GitHub OAuth App) -----------
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
CMS_ALLOWED_ORIGINS=http://localhost:5173

# --- Newsletter (leave empty; the form then reports a generic error) -------
LISTMONK_URL=
LISTMONK_LIST_EN=
LISTMONK_LIST_DE=

ORIGIN=http://localhost:5173
